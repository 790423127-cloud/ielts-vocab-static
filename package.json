{
  "name": "ielts-vocab-deepseek-edge-tts",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H :: -p 3000",
    "prebuild": "npm run lexicon:check",
    "build": "next build",
    "lint:undef": "npm run lint:errors",
    "lint:errors": "eslint app scripts tests/e2e middleware.js next.config.mjs eslint.config.mjs playwright.config.mjs --quiet",
    "lint:quality": "eslint app scripts tests/e2e middleware.js next.config.mjs eslint.config.mjs playwright.config.mjs",
    "lint:budget": "node scripts/eslint-warning-budget.mjs",
    "audit:dependencies": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "test:smoke": "playwright test tests/e2e/production-smoke.spec.mjs --config=playwright.config.mjs",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:performance": "playwright test tests/e2e/performance-budget.spec.mjs --config=playwright.config.mjs",
    "start": "next start -H :: -p 3000",
    "audit:core": "node scripts/core-vocab-quality-audit.mjs --write-reports",
    "quality:gate": "node scripts/core-vocab-quality-audit.mjs --gate",
    "quality:phrases": "node scripts/phrase-quality-gate.mjs --gate",
    "quality:all": "node scripts/core-vocab-quality-audit.mjs --gate && node scripts/phrase-quality-gate.mjs --gate && node scripts/sync-master-lexicon.mjs --check",
    "lexicon:sync": "node scripts/sync-master-lexicon.mjs",
    "lexicon:check": "node scripts/sync-master-lexicon.mjs --check",
    "vocab:recover-ai-cache:dry-run": "node scripts/recover-deepseek-word-cache.mjs --dry-run",
    "vocab:recover-ai-cache:apply": "node scripts/recover-deepseek-word-cache.mjs --apply",
    "phrases:repair-p0": "node scripts/repair-phrase-quality-p0.mjs",
    "vocab:gt-complete:dry-run": "node scripts/apply-gt-complete-vocab-patch.mjs --dry-run && node scripts/apply-gt-second-semantic-review.mjs --dry-run",
    "vocab:gt-complete:apply": "node scripts/apply-gt-complete-vocab-patch.mjs --apply && node scripts/apply-gt-second-semantic-review.mjs --apply && node scripts/apply-gt-complete-ui-patch.mjs",
    "vocab:gt-second-review:dry-run": "node scripts/apply-gt-second-semantic-review.mjs --dry-run",
    "vocab:gt-second-review:apply": "node scripts/apply-gt-second-semantic-review.mjs --apply",
    "test:quality": "node --test app/lib/vocab/__tests__/word-runtime-quality.test.mjs",
    "test:wide": "node scripts/run-wide-tests.mjs",
    "test": "node --test app/lib/reading-g-vocab/__tests__/reading-g-example-quality.test.mjs app/lib/vocab/__tests__/vocab-meaning-display.test.mjs app/lib/vocab/__tests__/word-study-eligibility.test.mjs app/lib/vocab/__tests__/gt-10500-expansion.test.mjs app/lib/vocab/__tests__/gt-complete-vocab-patch.test.mjs app/lib/vocab/__tests__/gt-second-semantic-review.test.mjs app/lib/vocab/__tests__/phrase-flashcard.test.mjs app/lib/vocab/__tests__/word-runtime-quality.test.mjs app/lib/vocab/__tests__/example-skeleton-tails.test.mjs app/lib/vocab/__tests__/reading-synonyms.test.mjs app/lib/vocab/__tests__/local-admin-guard.test.mjs app/lib/vocab/__tests__/static-export-responsive.test.mjs app/lib/vocab/__tests__/word-flashcard-session.test.mjs app/lib/vocab/__tests__/study-session.test.mjs app/lib/vocab/__tests__/phrase-flashcard-session.test.mjs app/lib/vocab/__tests__/lr-paraphrase-panel.test.mjs app/lib/vocab/__tests__/learning-entry-counts.test.mjs app/lib/vocab/__tests__/admin-ai-batch-plan.test.mjs app/lib/vocab/__tests__/admin-ai-batch-runner.test.mjs app/lib/vocab/__tests__/deepseek-cache-recovery.test.mjs app/lib/spelling/__tests__/vocab-10k.test.mjs app/lib/spelling/__tests__/vocab-speech-cache.test.mjs app/lib/spelling/__tests__/speech-audio-playback.test.mjs app/lib/spelling/__tests__/production-hook.test.mjs app/lib/spelling/__tests__/srs-review.test.mjs app/lib/spelling/__tests__/spelling-export.test.mjs app/lib/spelling/__tests__/spelling-categories.test.mjs app/lib/spelling/__tests__/personal-wrong-book.test.mjs app/lib/spelling/__tests__/personal-wrong-progress.test.mjs app/lib/spelling/__tests__/personal-wrong-lexicon-sync.test.mjs",
    "recover:gt10500": "node scripts/archive/historical/gt-10500-quality-recovery.mjs",
    "spelling:complete-lexicon": "node scripts/archive/historical/deepseek-spelling-lexicon-completion.mjs --generate && node scripts/archive/historical/deepseek-spelling-lexicon-completion.mjs --apply",
    "spelling:repair-examples": "node scripts/archive/historical/deepseek-spelling-example-repair.mjs --generate && node scripts/archive/historical/deepseek-spelling-example-repair.mjs --apply",
    "audio:prefill": "node scripts/prefill-all-audio.mjs",
    "audio:enhance-real": "node scripts/enhance-real-audio-cache.mjs",
    "audio:enhance-edge": "node scripts/enhance-edge-audio-cache.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.20",
    "node-edge-tts": "^1.2.8",
    "react": "19.0.1",
    "react-dom": "19.0.1"
  },
  "overrides": {
    "postcss": "8.5.10",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.20",
    "@playwright/test": "1.61.1",
    "eslint": "9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "16.5.0"
  }
}
