{
  "name": "ielts-vocab-deepseek-edge-tts",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H :: -p 3000",
    "build": "next build",
    "start": "next start -H :: -p 3000",
    "audit:core": "node scripts/core-vocab-quality-audit.mjs --write-reports",
    "quality:gate": "node scripts/core-vocab-quality-audit.mjs --gate",
    "quality:phrases": "node scripts/phrase-quality-gate.mjs --gate",
    "quality:all": "node scripts/core-vocab-quality-audit.mjs --gate && node scripts/phrase-quality-gate.mjs --gate && node scripts/sync-master-lexicon.mjs --check",
    "lexicon:sync": "node scripts/sync-master-lexicon.mjs",
    "lexicon:check": "node scripts/sync-master-lexicon.mjs --check",
    "phrases:repair-p0": "node scripts/repair-phrase-quality-p0.mjs",
    "test:quality": "node --test app/lib/vocab/__tests__/word-runtime-quality.test.mjs",
    "test:wide": "node scripts/run-wide-tests.mjs",
    "test": "node --test app/lib/vocab/__tests__/gt-10500-expansion.test.mjs app/lib/vocab/__tests__/phrase-flashcard.test.mjs app/lib/vocab/__tests__/word-runtime-quality.test.mjs app/lib/vocab/__tests__/example-skeleton-tails.test.mjs app/lib/vocab/__tests__/reading-synonyms.test.mjs app/lib/vocab/__tests__/local-admin-guard.test.mjs app/lib/vocab/__tests__/word-flashcard-session.test.mjs app/lib/vocab/__tests__/study-session.test.mjs app/lib/vocab/__tests__/phrase-flashcard-session.test.mjs app/lib/vocab/__tests__/lr-paraphrase-panel.test.mjs app/lib/vocab/__tests__/learning-entry-counts.test.mjs app/lib/spelling/__tests__/vocab-10k.test.mjs app/lib/spelling/__tests__/vocab-speech-cache.test.mjs app/lib/spelling/__tests__/production-hook.test.mjs app/lib/spelling/__tests__/srs-review.test.mjs app/lib/spelling/__tests__/spelling-export.test.mjs app/lib/spelling/__tests__/spelling-categories.test.mjs app/lib/spelling/__tests__/personal-wrong-book.test.mjs app/lib/spelling/__tests__/personal-wrong-progress.test.mjs app/lib/spelling/__tests__/personal-wrong-lexicon-sync.test.mjs",
    "recover:gt10500": "node scripts/archive/historical/gt-10500-quality-recovery.mjs",
    "spelling:complete-lexicon": "node scripts/archive/historical/deepseek-spelling-lexicon-completion.mjs --generate && node scripts/archive/historical/deepseek-spelling-lexicon-completion.mjs --apply",
    "spelling:repair-examples": "node scripts/archive/historical/deepseek-spelling-example-repair.mjs --generate && node scripts/archive/historical/deepseek-spelling-example-repair.mjs --apply",
    "audio:prefill": "node scripts/prefill-all-audio.mjs",
    "audio:enhance-real": "node scripts/enhance-real-audio-cache.mjs",
    "audio:enhance-edge": "node scripts/enhance-edge-audio-cache.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "next": "15.3.4",
    "node-edge-tts": "^1.2.8",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
